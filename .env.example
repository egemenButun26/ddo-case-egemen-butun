# Uygulama veritabaninin adi
POSTGRES_DB=parkakil

# Veritabani kullanici adi
POSTGRES_USER=parkakil

# Veritabani sifresi (yalnizca demo degeri; gercek ortamda degistirin)
POSTGRES_PASSWORD=demo-degistir

# Kamera olay ucu icin API anahtari (yalnizca demo degeri; gercek ortamda en az 32 karakterlik rastgele bir deger kullanin)
CAMERA_API_KEY=demo-kamera-anahtari-degistir-0000000000

# Prometheus /metrics ucu icin Bearer token (demo degeri; doluysa en az 16 karakter, bos birakilirsa uc tum istekleri 401 ile reddeder)
METRICS_TOKEN=demo-metrics-token-degistir

# API'nin host makinede dinleyecegi port
API_HOST_PORT=8080

# Web arayuzunun host makinede dinleyecegi port
WEB_HOST_PORT=3000

# Log seviyesi: debug, info, warn, error
LOG_LEVEL=info

# Duzgun kapanis icin taninan sure
SHUTDOWN_TIMEOUT=10s

# Veritabani pingi icin zaman asimi
DB_PING_TIMEOUT=2s

# Sunucu tarafli oturum suresi (varsayilan 12h)
AUTH_SESSION_TTL=12h

# Suresi dolmus rezervasyonlarin serbest birakilma araligi (varsayilan 30s)
RESERVATION_RELEASE_INTERVAL=30s

# Doluluk sayaci kayma denetimi araligi (varsayilan 5m)
DRIFT_CHECK_INTERVAL=5m

# Basarisiz abonelik faturalarinin yeniden deneme (dunning) dongusu (varsayilan 1m)
DUNNING_INTERVAL=1m

# Odeme saglayici adresi (varsayilan http://providersim:8090)
# PROVIDER_URL=http://providersim:8090

# Saglayici bildirimlerini imzalayan webhook sirri (zorunlu, en az 16 karakter)
PROVIDER_WEBHOOK_SECRET=demo-provider-secret-degistir

# Saglayici yaniti icin zaman asimi (varsayilan 30s)
# PROVIDER_TIMEOUT=30s

# Bekleyen odemelerin zaman asimi kontrol araligi (varsayilan 10s)
# PAYMENT_EXPIRE_INTERVAL=10s

# Saglayici callback adresi icin API taban adresi (varsayilan http://api:8080)
# PUBLIC_API_URL=http://api:8080

# Saglayici simulatoru tohumu (ayni tohum + ayni ayar = ayni karar dizisi)
PROVIDERSIM_SEED=4242

# Demo seed parolasi (seed servisi icin zorunlu; gercek ortamda degistirin)
SEED_DEMO_PASSWORD=demo-parola-degistir

# Simulator tohumu (ayni tohum + ayni ayar = ayni olay dizisi)
SIM_SEED=20261026

# Gunluk toplam plaka olay sayisi
SIM_EVENTS_PER_DAY=20000

# Simule zaman carpani (60 -> 1 gun yaklasik 24 dakika)
SIM_SPEED=60

# Simulasyon baslangici (bos birakilirsa 2026-10-26T00:00:00+03:00 kullanilir)
SIM_START=2026-10-26T00:00:00+03:00

# API adresi (varsayilan http://api:8080)
# SIM_API_URL=http://api:8080
